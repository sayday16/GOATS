@HostAddress = http://localhost:5585

###
POST {{HostAddress}}/api/auth/register
Content-Type: application/json

{
  "email": "cashier@gmail.com",
  "password": "password123",
  "confirmPassword": "password123",
  "role": 1,
  "storeName": "NonExistentStore",
  "storePassword": "anyPassword"
}

### 
POST {{HostAddress}}/api/auth/register
Content-Type: application/json

{
  "email": "owner@gmail.com",
  "password": "password123",
  "confirmPassword": "password123",
  "role": 0,
  "storeName": "GoatShop Lviv",
  "storePassword": "secretStorePass"
}

### 
POST {{HostAddress}}/api/auth/register
Content-Type: application/json

{
  "email": "cashier@gmail.com",
  "password": "password123",
  "confirmPassword": "password123",
  "role": 1,
  "storeName": "GoatShop Lviv",
  "storePassword": "secretStorePass"
}

###
# @name login
POST {{HostAddress}}/api/auth/login
Content-Type: application/json

{
  "email": "owner@gmail.com",
  "password": "password123"
}

###
GET {{HostAddress}}/api/auth/me
Authorization: Bearer {{login.response.body.$.accessToken}}

###
GET {{HostAddress}}/api/auth/me

###
# @name createProduct
POST {{HostAddress}}/api/products
Authorization: Bearer {{login.response.body.$.accessToken}}
Content-Type: application/json

{
  "title": "Levi's 501 vintage, W32",
  "purchasePrice": 400,
  "salePrice": 1200
}

###
GET {{HostAddress}}/api/products
Authorization: Bearer {{login.response.body.$.accessToken}}

###
GET {{HostAddress}}/api/products?status=InStock
Authorization: Bearer {{login.response.body.$.accessToken}}

###
PUT {{HostAddress}}/api/products/{{createProduct.response.body.$.product.id}}
Authorization: Bearer {{login.response.body.$.accessToken}}
Content-Type: application/json

{
  "title": "Levi's 501 vintage, W32 L34",
  "purchasePrice": 400,
  "salePrice": 1100
}

###
POST {{HostAddress}}/api/products/{{createProduct.response.body.$.product.id}}/sell
Authorization: Bearer {{login.response.body.$.accessToken}}

###
DELETE {{HostAddress}}/api/products/{{createProduct.response.body.$.product.id}}
Authorization: Bearer {{login.response.body.$.accessToken}}