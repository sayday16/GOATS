<UserControl x:Class="LogWindowUI.Views.AnalyticsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:LogWindowUI.ViewModels"
             Background="#F5F7FA">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Recources/Styles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <BooleanToVisibilityConverter x:Key="BoolVis"/>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                <TextBlock Text="Аналітика" FontSize="26" FontWeight="Bold" Foreground="#1A1A1A"/>
                <TextBlock Text="Показники продажів та фінансів магазину" FontSize="13" Foreground="#8B92A1"/>
            </StackPanel>

            <Button Grid.Column="1" Content="🔄 Оновити"
                    Command="{Binding RefreshCommand}"
                    Height="40" Width="130" FontSize="14"
                    Background="White" Foreground="#1E3A5F"
                    BorderBrush="#1E3A5F" BorderThickness="1"
                    Cursor="Hand">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Button.Template>
            </Button>
        </Grid>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>

                <Border Background="#FEE2E2" BorderBrush="#EF4444" BorderThickness="1"
                        CornerRadius="8" Padding="16,12" Margin="0,0,0,16"
                        Visibility="{Binding IsLimitWarning, Converter={StaticResource BoolVis}}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="⚠️" FontSize="18" VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <TextBlock Text="Увага! Обіг наближається до річного ліміту ФОП або перевищив його!"
                                   Foreground="#991B1B" FontSize="14" FontWeight="SemiBold"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <Border Background="#FFF0F0" CornerRadius="8" Padding="16" Margin="0,0,0,16"
                        Visibility="{Binding HasError, Converter={StaticResource BoolVis}}">
                    <TextBlock Text="{Binding ErrorMessage}" Foreground="#C0392B" FontSize="14"
                               TextWrapping="Wrap"/>
                </Border>

                <Grid Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Background="White" CornerRadius="10"
                            BorderBrush="#E2E8F0" BorderThickness="1" Padding="16">
                        <StackPanel>
                            <TextBlock Text="💰 Виручка за місяць" FontSize="12" Foreground="#8B92A1"/>
                            <TextBlock Text="{Binding MonthRevenue, StringFormat={}{0:N2} ₴}"
                                       FontSize="20" FontWeight="Bold" Foreground="#1A1A1A" Margin="0,8,0,0"/>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="2" Background="White" CornerRadius="10"
                            BorderBrush="#E2E8F0" BorderThickness="1" Padding="16">
                        <StackPanel>
                            <TextBlock Text="📈 Чистий прибуток" FontSize="12" Foreground="#8B92A1"/>
                            <TextBlock Text="{Binding MonthNetProfit, StringFormat={}{0:N2} ₴}"
                                       FontSize="20" FontWeight="Bold" Foreground="#10B981" Margin="0,8,0,0"/>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="4" Background="White" CornerRadius="10"
                            BorderBrush="#E2E8F0" BorderThickness="1" Padding="16">
                        <StackPanel>
                            <TextBlock Text="🧾 Кількість чеків" FontSize="12" Foreground="#8B92A1"/>
                            <TextBlock Text="{Binding MonthReceiptsCount}"
                                       FontSize="20" FontWeight="Bold" Foreground="#1A1A1A" Margin="0,8,0,0"/>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="6" Background="White" CornerRadius="10"
                            BorderBrush="#E2E8F0" BorderThickness="1" Padding="16">
                        <StackPanel>
                            <TextBlock Text="🎯 Середній чек" FontSize="12" Foreground="#8B92A1"/>
                            <TextBlock Text="{Binding MonthAverageReceipt, StringFormat={}{0:N2} ₴}"
                                       FontSize="20" FontWeight="Bold" Foreground="#1A1A1A" Margin="0,8,0,0"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <Border Background="White" CornerRadius="10" BorderBrush="#E2E8F0" BorderThickness="1"
                        Padding="16" Margin="0,0,0,16">
                    <StackPanel>
                        <Grid Margin="0,0,0,8">
                            <TextBlock Text="📊 Річний обіг та ліміт ФОП" FontSize="14" FontWeight="SemiBold"
                                       Foreground="#1A1A1A" HorizontalAlignment="Left"/>
                            <TextBlock Text="{Binding LimitUsedPercent, StringFormat={}{0:N1}% використано}"
                                       FontSize="13" FontWeight="SemiBold" Foreground="#1E3A5F"
                                       HorizontalAlignment="Right"/>
                        </Grid>

                        <ProgressBar Height="10" Value="{Binding LimitUsedPercent, Mode=OneWay}"
                                     Maximum="100" Margin="0,4,0,8" Foreground="#1E3A5F"/>

                        <Grid>
                            <TextBlock Text="{Binding YearTurnover, StringFormat={}Обіг за рік: {0:N2} ₴}"
                                       FontSize="12" Foreground="#8B92A1" HorizontalAlignment="Left"/>
                            <TextBlock Text="{Binding AnnualTurnoverLimit, StringFormat={}Ліміт: {0:N2} ₴}"
                                       FontSize="12" Foreground="#8B92A1" HorizontalAlignment="Right"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <Grid Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="1.2*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Background="White" CornerRadius="10"
                            BorderBrush="#E2E8F0" BorderThickness="1" Padding="14">
                        <StackPanel>
                            <TextBlock Text="🏆 Топ брендів" FontSize="14" FontWeight="SemiBold"
                                       Foreground="#1A1A1A" Margin="0,0,0,10"/>
                            <DataGrid ItemsSource="{Binding TopBrands}" AutoGenerateColumns="False"
                                      IsReadOnly="True" CanUserAddRows="False" HeadersVisibility="Column"
                                      GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#E2E8F0"
                                      Background="White" BorderThickness="0" MaxHeight="260">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Бренд" Binding="{Binding Brand}" Width="*"/>
                                    <DataGridTextColumn Header="Продано" Binding="{Binding ItemsSold, StringFormat={}{0} шт.}" Width="65"/>
                                    <DataGridTextColumn Header="Виручка" Binding="{Binding Revenue, StringFormat={}{0:N0} ₴}" Width="85"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="2" Background="White" CornerRadius="10"
                            BorderBrush="#E2E8F0" BorderThickness="1" Padding="14">
                        <StackPanel>
                            <TextBlock Text="⏳ Завислі товари (>30 днів)" FontSize="14" FontWeight="SemiBold"
                                       Foreground="#1A1A1A" Margin="0,0,0,10"/>
                            <DataGrid ItemsSource="{Binding StaleProducts}" AutoGenerateColumns="False"
                                      IsReadOnly="True" CanUserAddRows="False" HeadersVisibility="Column"
                                      GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#E2E8F0"
                                      Background="White" BorderThickness="0" MaxHeight="260">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Товар" Binding="{Binding Title}" Width="*"/>
                                    <DataGridTextColumn Header="Бренд" Binding="{Binding Brand}" Width="75"/>
                                    <DataGridTextColumn Header="Днів" Binding="{Binding DaysInStock, StringFormat={}{0} дн.}" Width="55"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="4" Background="White" CornerRadius="10"
                            BorderBrush="#E2E8F0" BorderThickness="1" Padding="14">
                        <StackPanel>
                            <TextBlock Text="📋 Останні операції" FontSize="14" FontWeight="SemiBold"
                                       Foreground="#1A1A1A" Margin="0,0,0,10"/>
                            <DataGrid ItemsSource="{Binding RecentOperations}" AutoGenerateColumns="False"
                                      IsReadOnly="True" CanUserAddRows="False" HeadersVisibility="Column"
                                      GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#E2E8F0"
                                      Background="White" BorderThickness="0" MaxHeight="260">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Чек" Binding="{Binding Number, StringFormat={}#{0}}" Width="55"/>
                                    <DataGridTextColumn Header="Час" Binding="{Binding CreatedAt, StringFormat={}{0:dd.MM HH:mm}}" Width="85"/>
                                    <DataGridTextColumn Header="Сума" Binding="{Binding Total, StringFormat={}{0:N0} ₴}" Width="75"/>
                                    <DataGridTemplateColumn Header="Оплата" Width="*">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <TextBlock Text="Картка" VerticalAlignment="Center">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding PaymentMethod}" Value="Cash">
                                                                        <Setter Property="Text" Value="Готівка"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                    <Border Visibility="{Binding HasReturns, Converter={StaticResource BoolVis}}"
                                                            Background="#FEE2E2" CornerRadius="4" Padding="4,1" Margin="6,0,0,0">
                                                        <TextBlock Text="Повернення" Foreground="#991B1B" FontSize="10"/>
                                                    </Border>
                                                </StackPanel>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                        </StackPanel>
                    </Border>
                </Grid>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
