<Window x:Class="LogWindowUI.Views.ShellWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:LogWindowUI.ViewModels"
        xmlns:views="clr-namespace:LogWindowUI.Views"
        Title="GOAT Store" Height="720" Width="1280"
        MinWidth="1024" MinHeight="600"
        WindowStartupLocation="CenterScreen"
        Background="#F5F7FA">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Recources/Styles.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <BooleanToVisibilityConverter x:Key="BoolVis"/>

            <Style x:Key="NavButton" TargetType="Button">
                <Setter Property="Margin" Value="0,4"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bg" CornerRadius="8"
                                    Background="{TemplateBinding Background}"
                                    Padding="12,10">
                                <ContentPresenter/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bg" Property="Background" Value="#1E3A5F"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
                <Style.Triggers>
                    <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="True">
                        <Setter Property="Background" Value="#2A4D7A"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>

            <DataTemplate DataType="{x:Type vm:InventoryViewModel}">
                <views:InventoryView/>
            </DataTemplate>

            <DataTemplate DataType="{x:Type vm:MainViewModel}">
                <views:PosView/>
            </DataTemplate>

            <DataTemplate DataType="{x:Type vm:ReturnsViewModel}">
                <views:ReturnsView/>
            </DataTemplate>

            <DataTemplate DataType="{x:Type vm:AnalyticsViewModel}">
                <views:AnalyticsView/>
            </DataTemplate>
        </ResourceDictionary>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="#101726">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Margin="20,24,20,24">
                    <TextBlock Text="🐐 GOAT Store" Foreground="White"
                               FontSize="18" FontWeight="Bold"/>
                    <TextBlock Text="{Binding StoreName}" Foreground="#8B92A1"
                               FontSize="12" Margin="0,2,0,0"/>
                </StackPanel>

                <StackPanel Grid.Row="1" Margin="12,0">

                    <Button Command="{Binding ShowInventoryCommand}"
                            Tag="{Binding IsInventoryActive}"
                            Visibility="{Binding IsAdmin, Converter={StaticResource BoolVis}}"
                            Style="{StaticResource NavButton}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="📦" FontSize="18" VerticalAlignment="Center"/>
                            <TextBlock Text="Склад" Foreground="White" FontSize="14"
                                       FontWeight="SemiBold" Margin="10,0,0,0"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Button Command="{Binding ShowPosCommand}"
                            Tag="{Binding IsPosActive}"
                            Style="{StaticResource NavButton}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🛒" FontSize="18" VerticalAlignment="Center"/>
                            <TextBlock Text="Каса" Foreground="White" FontSize="14"
                                       FontWeight="SemiBold" Margin="10,0,0,0"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Button Command="{Binding ShowReturnsCommand}"
                            Tag="{Binding IsReturnsActive}"
                            Style="{StaticResource NavButton}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="↩️" FontSize="18" VerticalAlignment="Center"/>
                            <TextBlock Text="Повернення" Foreground="White" FontSize="14"
                                       FontWeight="SemiBold" Margin="10,0,0,0"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Button Command="{Binding ShowAnalyticsCommand}"
                            Tag="{Binding IsAnalyticsActive}"
                            Visibility="{Binding IsAdmin, Converter={StaticResource BoolVis}}"
                            Style="{StaticResource NavButton}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="📊" FontSize="18" VerticalAlignment="Center"/>
                            <TextBlock Text="Аналітика" Foreground="White" FontSize="14"
                                       FontWeight="SemiBold" Margin="10,0,0,0"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                </StackPanel>

                <Border Grid.Row="2" Margin="12,0,12,20" Background="#1E3A5F"
                        CornerRadius="10" Padding="12">
                    <StackPanel>
                        <TextBlock Text="{Binding UserEmail}" Foreground="White"
                                   FontSize="13" FontWeight="SemiBold"
                                   TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="{Binding UserRole}" Foreground="#8B92A1"
                                   FontSize="11" Margin="0,2,0,0"/>
                        <Button Content="Вийти" Command="{Binding LogoutCommand}"
                                Margin="0,8,0,0" Height="28" FontSize="12"
                                Background="Transparent" Foreground="#FCA5A5"
                                BorderBrush="#EF4444" BorderThickness="1"
                                Cursor="Hand">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}"
                                            BorderBrush="{TemplateBinding BorderBrush}"
                                            BorderThickness="{TemplateBinding BorderThickness}"
                                            CornerRadius="6">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <ContentPresenter Grid.Column="1" Content="{Binding CurrentView}"/>
    </Grid>
</Window>
