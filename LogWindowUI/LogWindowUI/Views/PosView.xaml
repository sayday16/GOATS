<UserControl x:Class="LogWindowUI.Views.PosView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             Background="#F4F6F9"
             mc:Ignorable="d" 
             d:DesignHeight="900" d:DesignWidth="1220">

    <UserControl.Resources>
        <Style x:Key="RoundedButtonStyle" TargetType="Button">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="68"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="White" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1">
            <DockPanel LastChildFill="False">
                <Border x:Name="SearchBorder" DockPanel.Dock="Left" Width="520" Height="42" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Margin="24,0,0,0">
                    <Grid>
                        <Path Data="M9.5,3A6.5,6.5 0 0,1 16,9.5C16,11.11 15.41,12.59 14.44,13.73L14.71,14H15.5L20.5,19L19,20.5L14,15.5V14.71L13.73,14.44C12.59,15.41 11.11,16 9.5,16A6.5,6.5 0 0,1 3,9.5A6.5,6.5 0 0,1 9.5,3M9.5,5C7,5 5,7 5,9.5C5,12 7,14 9.5,14C12,14 14,12 14,9.5C14,7 12,5 9.5,5Z"
                              Fill="#94A3B8" Stretch="Uniform" Width="16" Height="16" HorizontalAlignment="Left" Margin="14,0,0,0"/>
                        <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" Background="Transparent" BorderThickness="0" VerticalAlignment="Center" Padding="38,0,110,0" FontSize="13" Foreground="#1E293B"
                                 ToolTip="Назва, бренд або артикул. Enter - додати точний збіг">
                            <TextBox.InputBindings>
                                <KeyBinding Key="Enter" Command="{Binding SearchCommand}" />
                                <KeyBinding Key="Down" Command="{Binding OpenSuggestionsCommand}" />
                            </TextBox.InputBindings>
                        </TextBox>
                        <Button HorizontalAlignment="Right" Margin="0,0,6,0" Height="30" Padding="10,0"
                                Background="#EFF6FF" BorderBrush="#BFDBFE" BorderThickness="1" Cursor="Hand"
                                Style="{StaticResource RoundedButtonStyle}" Command="{Binding OpenSuggestionsCommand}"
                                ToolTip="Показати товари в наявності">
                            <StackPanel Orientation="Horizontal" Margin="10,0">
                                <TextBlock Text="Усі товари" FontSize="12" FontWeight="SemiBold" Foreground="#2563EB" VerticalAlignment="Center"/>
                                <Path Data="M7,10L12,15L17,10H7Z" Fill="#2563EB" Stretch="Uniform" Width="9" Height="9" Margin="6,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <Popup IsOpen="{Binding IsSuggestionsOpen, Mode=TwoWay}" PlacementTarget="{Binding ElementName=SearchBorder}"
                               Placement="Bottom" VerticalOffset="6" StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade">
                            <Border Width="520" MaxHeight="420" Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="10" Padding="6">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="16" ShadowDepth="2" Opacity="0.15"/>
                                </Border.Effect>
                                <StackPanel>
                                    <TextBlock Text="{Binding SuggestionsMessage}" Margin="10,8" FontSize="13" Foreground="#64748B" TextWrapping="Wrap"
                                               Visibility="{Binding HasSuggestionsMessage, Converter={StaticResource BoolToVis}}"/>
                                    <ScrollViewer MaxHeight="400" VerticalScrollBarVisibility="Auto">
                                        <ItemsControl ItemsSource="{Binding Suggestions}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Button Cursor="Hand" HorizontalContentAlignment="Stretch"
                                                            Command="{Binding DataContext.AddSuggestionCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                            CommandParameter="{Binding}">
                                                        <Button.Template>
                                                            <ControlTemplate TargetType="Button">
                                                                <Border x:Name="Row" Background="Transparent" CornerRadius="6" Padding="10,8">
                                                                    <ContentPresenter/>
                                                                </Border>
                                                                <ControlTemplate.Triggers>
                                                                    <Trigger Property="IsMouseOver" Value="True">
                                                                        <Setter TargetName="Row" Property="Background" Value="#EFF6FF"/>
                                                                    </Trigger>
                                                                </ControlTemplate.Triggers>
                                                            </ControlTemplate>
                                                        </Button.Template>
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                            </Grid.ColumnDefinitions>
                                                            <StackPanel>
                                                                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="13" Foreground="#0F172A" TextTrimming="CharacterEllipsis"/>
                                                                <TextBlock FontSize="11" Foreground="#64748B" Margin="0,2,0,0">
                                                                    <Run Text="{Binding Brand, Mode=OneWay}"/><Run Text=" · "/><Run Text="{Binding Size, Mode=OneWay}"/><Run Text=" · "/><Run Text="{Binding Sku, Mode=OneWay}"/>
                                                                </TextBlock>
                                                            </StackPanel>
                                                            <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                                                                <TextBlock Text="{Binding SalePrice, StringFormat={}{0:N0} ₴}" FontWeight="Bold" FontSize="13" Foreground="#0F172A" HorizontalAlignment="Right"/>
                                                                <TextBlock Text="{Binding Quantity, StringFormat=В наявності: {0} шт.}" FontSize="11" Foreground="#64748B" HorizontalAlignment="Right"/>
                                                            </StackPanel>
                                                        </Grid>
                                                    </Button>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>
                                </StackPanel>
                            </Border>
                        </Popup>
                    </Grid>
                </Border>

                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="0,0,24,0" VerticalAlignment="Center">
                    <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="10" Padding="10,6" Margin="0,0,14,0">
                        <StackPanel Orientation="Horizontal">
                            <Border Width="28" Height="28" CornerRadius="6" Background="#EFF6FF" VerticalAlignment="Center">
                                <Path Data="M12,18H6V14H12M21,14V12L20,7H4L3,12V14H4V20H14V14H18V20H20V14M20,4H4V6H20V4Z"
                                      Fill="#2563EB" Stretch="Uniform" Width="14" Height="14" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel Margin="8,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding StoreLocation}" FontWeight="SemiBold" FontSize="12" Foreground="#1E293B"/>
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse Width="6" Height="6" Fill="#10B981" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding CashRegister}" Foreground="#64748B" FontSize="11" Margin="6,0,0,0"/>
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Border Width="38" Height="38" CornerRadius="19" BorderBrush="#E2E8F0" BorderThickness="1" Background="White" Margin="0,0,10,0" Cursor="Hand">
                        <Path Data="M21,19V20H3V19L5,17V11C5,7.9 7.03,5.17 10,4.29C10,4.19 10,4.1 10,4A2,2 0 0,1 12,2A2,2 0 0,1 14,4C14,4.1 14,4.19 14,4.29C16.97,5.17 19,7.9 19,11V17L21,19M14,21A2,2 0 0,1 12,23A2,2 0 0,1 10,21"
                              Fill="#64748B" Stretch="Uniform" Width="16" Height="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>

                    <Border Width="38" Height="38" CornerRadius="19" Background="#DBEAFE" Cursor="Hand">
                        <TextBlock Text="ОК" Foreground="#1D4ED8" FontWeight="Bold" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                </StackPanel>
            </DockPanel>
        </Border>

        <Grid Grid.Row="1" Margin="24,20,24,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="380"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="White" CornerRadius="14" BorderBrush="#E2E8F0" BorderThickness="1" Padding="24">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,16">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Поточний чек" FontSize="20" FontWeight="Bold" Foreground="#0F172A"/>
                                <Border Background="#EEF2FF" CornerRadius="10" Padding="8,2" Margin="10,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding TotalItemsCountText}" Foreground="#4F46E5" FontSize="12" FontWeight="SemiBold"/>
                                </Border>
                            </StackPanel>
                            <TextBlock Text="{Binding ReceiptNumber}" Foreground="#94A3B8" FontSize="12" Margin="0,4,0,0"/>
                        </StackPanel>

                        <Border HorizontalAlignment="Right" Background="White" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="8" Padding="12,6" Cursor="Hand">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="M2,6H4V18H2V6M5,6H6V18H5V6M7,6H10V18H7V6M11,6H12V18H11V6M14,6H16V18H14V6M17,6H20V18H17V6M21,6H22V18H21V6Z"
                                      Fill="#1E293B" Stretch="Uniform" Width="14" Height="14" VerticalAlignment="Center"/>
                                <TextBlock Text="Сканувати" Foreground="#1E293B" FontWeight="SemiBold" FontSize="13" Margin="8,0,0,0"/>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <Grid Grid.Row="1" Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2.3*"/>
                            <ColumnDefinition Width="1.5*"/>
                            <ColumnDefinition Width="1.4*"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0" Text="НАЗВА" Foreground="#94A3B8" FontSize="11" FontWeight="SemiBold"/>
                        <TextBlock Grid.Column="1" Text="СПЕЦИФІКАЦІЯ" Foreground="#94A3B8" FontSize="11" FontWeight="SemiBold"/>
                        <TextBlock Grid.Column="2" Text="ЦІНА" Foreground="#94A3B8" FontSize="11" FontWeight="SemiBold"/>
                    </Grid>

                    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding CartItems}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="#F1F5F9" BorderThickness="0,0,0,1" Padding="0,12,0,12">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="2.3*"/>
                                                <ColumnDefinition Width="1.5*"/>
                                                <ColumnDefinition Width="1.4*"/>
                                            </Grid.ColumnDefinitions>

                                            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                                <Border Width="44" Height="44" Background="#F1F5F9" CornerRadius="8" Margin="0,0,12,0">
                                                    <Path Data="M16,21H8A1,1 0 0,1 7,20V12H4A1,1 0 0,1 3,11L5,4A2,2 0 0,1 7,2H17A2,2 0 0,1 19,4L21,11A1,1 0 0,1 20,12H17V20A1,1 0 0,1 16,21Z"
                                                          Fill="#94A3B8" Stretch="Uniform" Width="18" Height="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <StackPanel VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="14" Foreground="#0F172A"/>
                                                    <TextBlock FontSize="12" Foreground="#94A3B8" Margin="0,2,0,0">
                                                        <Run Text="{Binding Brand, Mode=OneWay}"/><Run Text=" · "/><Run Text="{Binding Sku, Mode=OneWay}"/>
                                                    </TextBlock>
                                                </StackPanel>
                                            </StackPanel>

                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Category}" FontSize="12" Foreground="#64748B"/>
                                                <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="4" Padding="6,2" HorizontalAlignment="Left" Margin="0,4,0,0">
                                                    <TextBlock Text="{Binding Size}" FontSize="12" Foreground="#1E293B"/>
                                                </Border>
                                            </StackPanel>

                                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,12,0"
                                                            Visibility="{Binding CanChangeQuantity, Converter={StaticResource BoolToVis}}">
                                                    <Button Content="-" Width="24" Height="24" Background="#F1F5F9" BorderBrush="#CBD5E1" BorderThickness="1" Cursor="Hand"
                                                            Style="{StaticResource RoundedButtonStyle}"
                                                            Command="{Binding DataContext.DecreaseQuantityCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            CommandParameter="{Binding}"/>
                                                    <TextBlock Text="{Binding Quantity}" FontWeight="SemiBold" FontSize="13" Foreground="#0F172A"
                                                               VerticalAlignment="Center" Margin="8,0"/>
                                                    <Button Content="+" Width="24" Height="24" Background="#F1F5F9" BorderBrush="#CBD5E1" BorderThickness="1" Cursor="Hand"
                                                            Style="{StaticResource RoundedButtonStyle}"
                                                            Command="{Binding DataContext.IncreaseQuantityCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            CommandParameter="{Binding}"/>
                                                </StackPanel>
                                                <TextBlock Text="{Binding TotalPriceText}" FontWeight="Bold" FontSize="15" Foreground="#0F172A" VerticalAlignment="Center"/>
                                                <Button Margin="16,0,0,0" Background="Transparent" BorderThickness="0" Cursor="Hand"
                                                        Command="{Binding DataContext.RemoveItemCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}">
                                                    <Path Data="M19,4H15.5L14.5,3H9.5L8.5,4H5V6H19M6,19A2,2 0 0,0 8,21H16A2,2 0 0,0 18,19V7H6V19Z"
                                                          Fill="#94A3B8" Stretch="Uniform" Width="14" Height="14"/>
                                                </Button>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <Grid Grid.Row="3" Margin="0,16,0,0">
                        <TextBlock Text="⌨ F2 - пошук · Del - видалити позицію" Foreground="#94A3B8" FontSize="12" VerticalAlignment="Center"/>
                        <Button HorizontalAlignment="Right" Background="Transparent" BorderThickness="0" Cursor="Hand" Command="{Binding ClearCartCommand}">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="M19,4H15.5L14.5,3H9.5L8.5,4H5V6H19M6,19A2,2 0 0,0 8,21H16A2,2 0 0,0 18,19V7H6V19Z"
                                      Fill="#EF4444" Stretch="Uniform" Width="13" Height="13" VerticalAlignment="Center"/>
                                <TextBlock Text="Очистити чек" Foreground="#EF4444" FontWeight="Medium" FontSize="13" Margin="6,0,0,0"/>
                            </StackPanel>
                        </Button>
                    </Grid>
                </Grid>
            </Border>

            <Border Grid.Column="1" Background="White" CornerRadius="14" BorderBrush="#E2E8F0" BorderThickness="1" Margin="16,0,0,0">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="24">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0">
                            <StackPanel>
                                <TextBlock Text="До сплати" FontSize="18" FontWeight="Bold" Foreground="#0F172A"/>
                                <TextBlock Text="Перевірте замовлення" Foreground="#94A3B8" FontSize="12" Margin="0,4,0,0"/>
                            </StackPanel>
                            <Border HorizontalAlignment="Right" Width="32" Height="32" CornerRadius="8" Background="#ECFDF5">
                                <Path Data="M12,1L3,5V11C3,16.55 6.84,21.74 12,23C17.16,21.74 21,16.55 21,11V5L12,1M10,17L6,13L7.41,11.59L10,14.17L16.59,7.58L18,9L10,17Z"
                                      Fill="#10B981" Stretch="Uniform" Width="16" Height="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </Grid>

                        <Border Grid.Row="1" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Height="44" Padding="12,0" Margin="0,16,0,0" Cursor="Hand">
                            <DockPanel LastChildFill="False">
                                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Path Data="M12,4A4,4 0 0,1 16,8A4,4 0 0,1 12,12A4,4 0 0,1 8,8A4,4 0 0,1 12,4M12,14C16.42,14 20,15.79 20,18V20H4V18C4,15.79 7.58,14 12,14Z"
                                          Fill="#3B82F6" Stretch="Uniform" Width="14" Height="14" VerticalAlignment="Center"/>
                                    <TextBlock Text="Додати покупця" Foreground="#334155" FontSize="13" Margin="8,0,0,0" VerticalAlignment="Center"/>
                                </StackPanel>
                                <TextBlock DockPanel.Dock="Right" Text="›" Foreground="#94A3B8" FontSize="16" FontWeight="Bold" VerticalAlignment="Center"/>
                            </DockPanel>
                        </Border>

                        <StackPanel Grid.Row="2" Margin="0,20,0,0">
                            <DockPanel LastChildFill="False" Margin="0,0,0,10">
                                <TextBlock DockPanel.Dock="Left" Text="Сума товарів" Foreground="#64748B" FontSize="13"/>
                                <TextBlock DockPanel.Dock="Right" Text="{Binding SubtotalText}" Foreground="#0F172A" FontSize="14"/>
                            </DockPanel>
                            <DockPanel LastChildFill="False" Margin="0,0,0,10">
                                <TextBlock DockPanel.Dock="Left" Text="Знижка" Foreground="#64748B" FontSize="13"/>
                                <TextBlock DockPanel.Dock="Right" Text="{Binding DiscountText}" Foreground="#0F172A" FontSize="14"/>
                            </DockPanel>
                            <DockPanel LastChildFill="False" Margin="0,0,0,16">
                                <TextBlock DockPanel.Dock="Left" Text="До оплати" FontWeight="Bold" Foreground="#0F172A" FontSize="14"/>
                                <TextBlock DockPanel.Dock="Right" Text="{Binding TotalPayableText}" FontWeight="Bold" Foreground="#0F172A" FontSize="15"/>
                            </DockPanel>
                        </StackPanel>

                        <StackPanel Grid.Row="3">
                            <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Height="38" Padding="10,0" Margin="0,0,0,8">
                                <Grid>
                                    <TextBox Text="{Binding DiscountInput, UpdateSourceTrigger=PropertyChanged}"
                                             Background="Transparent" BorderThickness="0" VerticalAlignment="Center"
                                             FontSize="13" Foreground="#1E293B" Padding="0,0,24,0">
                                        <TextBox.InputBindings>
                                            <KeyBinding Key="Enter" Command="{Binding ApplyDiscountCommand}"/>
                                        </TextBox.InputBindings>
                                    </TextBox>
                                    <TextBlock Text="₴" Foreground="#94A3B8" FontSize="13" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                </Grid>
                            </Border>
                            <Button Height="40" Background="White" BorderBrush="#3B82F6" BorderThickness="1" Cursor="Hand"
                                    Style="{StaticResource RoundedButtonStyle}" Command="{Binding ApplyDiscountCommand}">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="M18.6 15.6L13.4 10.4C14 9.3 14 8 13.3 7.3C12.5 6.5 11.2 6.5 10.4 7.3C9.6 8.1 9.6 9.4 10.4 10.2C11.1 10.9 12.4 10.9 13.5 10.3L18.7 15.5C18.9 15.7 19.3 15.7 19.5 15.5C19.7 15.3 19.7 14.9 19.5 14.7L18.6 15.6M12 2A10 10 0 1 0 22 12A10 10 0 0 0 12 2Z"
                                          Fill="#2563EB" Stretch="Uniform" Width="14" Height="14" VerticalAlignment="Center"/>
                                    <TextBlock Text="Застосувати знижку" Foreground="#2563EB" FontWeight="SemiBold" FontSize="13" Margin="8,0,0,0"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>

                        <StackPanel Grid.Row="4" Margin="0,22,0,0">
                            <TextBlock Text="Спосіб оплати" Foreground="#64748B" FontSize="12" Margin="0,0,0,8"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="10"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <Button Grid.Column="0" Height="42" Command="{Binding SelectCardCommand}">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource RoundedButtonStyle}">
                                            <Setter Property="BorderThickness" Value="1"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsCardPayment}" Value="True">
                                                    <Setter Property="Background" Value="#EFF6FF"/>
                                                    <Setter Property="BorderBrush" Value="#3B82F6"/>
                                                    <Setter Property="Foreground" Value="#2563EB"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding IsCardPayment}" Value="False">
                                                    <Setter Property="Background" Value="White"/>
                                                    <Setter Property="BorderBrush" Value="#E2E8F0"/>
                                                    <Setter Property="Foreground" Value="#64748B"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                    <StackPanel Orientation="Horizontal">
                                        <Path Data="M20,8H4V6H20M20,18H4V12H20M20,4H4C2.89,4 2,4.89 2,6V18A2,2 0 0,0 4,20H20A2,2 0 0,0 22,18V6C22,4.89 21.1,4 20,4Z"
                                              Fill="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}" Stretch="Uniform" Width="14" Height="14" VerticalAlignment="Center"/>
                                        <TextBlock Text="Картка" FontWeight="SemiBold" FontSize="13" Margin="8,0,0,0"/>
                                    </StackPanel>
                                </Button>

                                <Button Grid.Column="2" Height="42" Command="{Binding SelectCashCommand}">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource RoundedButtonStyle}">
                                            <Setter Property="BorderThickness" Value="1"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsCashPayment}" Value="True">
                                                    <Setter Property="Background" Value="#EFF6FF"/>
                                                    <Setter Property="BorderBrush" Value="#3B82F6"/>
                                                    <Setter Property="Foreground" Value="#2563EB"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding IsCashPayment}" Value="False">
                                                    <Setter Property="Background" Value="White"/>
                                                    <Setter Property="BorderBrush" Value="#E2E8F0"/>
                                                    <Setter Property="Foreground" Value="#64748B"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                    <StackPanel Orientation="Horizontal">
                                        <Path Data="M3,6H21V18H3V6M12,9A3,3 0 0,1 15,12A3,3 0 0,1 12,15A3,3 0 0,1 9,12A3,3 0 0,1 12,9M7,8A2,2 0 0,1 5,10V14A2,2 0 0,1 7,16H17A2,2 0 0,1 19,14V10A2,2 0 0,1 17,8H7Z"
                                              Fill="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}" Stretch="Uniform" Width="14" Height="14" VerticalAlignment="Center"/>
                                        <TextBlock Text="Готівка" FontWeight="SemiBold" FontSize="13" Margin="8,0,0,0"/>
                                    </StackPanel>
                                </Button>
                            </Grid>
                        </StackPanel>

                        <Grid Grid.Row="6" Margin="0,30,0,16">
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="ВСЬОГО" Foreground="#94A3B8" FontSize="11" FontWeight="SemiBold"/>
