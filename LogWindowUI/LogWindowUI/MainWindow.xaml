<Window x:Class="LogWindowUI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="GOAT Store point of sale" Height="900" Width="1440"
        MinWidth="1024" MinHeight="600"
        Background="#F4F6F9"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <Style x:Key="RoundedButtonStyle" TargetType="Button">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="250"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="#101726">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="24,24,24,0">
                    <Border Width="40" Height="40" Background="#2563EB" CornerRadius="10">
                        <Path Data="M14.5427 20.7917V15.5833C14.5427 15.3071 14.4329 15.0421 14.2376 14.8468C14.0422 14.6514 13.7773 14.5417 13.501 14.5417H9.33435C9.05808 14.5417 8.79313 14.6514 8.59778 14.8468C8.40243 15.0421 8.29268 15.3071 8.29268 15.5833V20.7917M17.4322 9.65625C17.2151 9.44837 16.9261 9.33234 16.6254 9.33234C16.3248 9.33234 16.0358 9.44837 15.8187 9.65625C15.3343 10.1182 14.6906 10.376 14.0213 10.376C13.3519 10.376 12.7083 10.1182 12.2239 9.65625C12.0068 9.44868 11.718 9.33284 11.4176 9.33284C11.1173 9.33284 10.8285 9.44868 10.6114 9.65625C10.127 10.1186 9.48308 10.3765 8.81347 10.3765C8.14385 10.3765 7.49997 10.1186 7.01555 9.65625C6.7984 9.44837 6.50939 9.33234 6.20878 9.33234C5.90817 9.33234 5.61916 9.44837 5.40201 9.65625C4.93414 10.1027 4.31688 10.3591 3.67037 10.3756C3.02386 10.392 2.39437 10.1673 1.90441 9.74519C1.41445 9.32307 1.09909 8.73375 1.0197 8.09192C0.940315 7.4501 1.10258 6.80169 1.47493 6.27292L4.4843 1.91458C4.67525 1.63282 4.93232 1.40214 5.23303 1.2427C5.53374 1.08327 5.86894 0.999937 6.2093 1H16.626C16.9653 0.99987 17.2996 1.08265 17.5997 1.24113C17.8998 1.39962 18.1566 1.62902 18.3478 1.90938L21.3635 6.27604C21.7359 6.80523 21.898 7.45413 21.8181 8.09629C21.7382 8.73845 21.4221 9.32786 20.9314 9.74968C20.4406 10.1715 19.8104 10.3955 19.1635 10.378C18.5167 10.3606 17.8995 10.1029 17.4322 9.65521M3.08435 10.3231V18.7085C3.08435 19.2611 3.30384 19.791 3.69454 20.1817C4.08525 20.5724 4.61515 20.7919 5.16768 20.7919H17.6677C18.2202 20.7919 18.7501 20.5724 19.1408 20.1817C19.5315 19.791 19.751 19.2611 19.751 18.7085V10.3231"
                              Fill="Transparent" Stroke="White" StrokeThickness="2"
                              Stretch="Uniform" Width="20" Height="20" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="GOAT Store" Foreground="White" FontWeight="Bold" FontSize="14"/>
                        <TextBlock Text="Manager" Foreground="White" FontSize="14"/>
                    </StackPanel>
                </StackPanel>

                <TextBlock Grid.Row="1" Text="ПРОДАЖІ" Foreground="#526077" FontWeight="SemiBold" FontSize="11" Margin="24,32,0,12"/>

                <StackPanel Grid.Row="2" Margin="16,0,16,0">
                    <Border Background="#1E2640" CornerRadius="8" Padding="14,10" Margin="0,0,0,6">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="M17,18A2,2 0 0,1 19,20A2,2 0 0,1 17,22A2,2 0 0,1 15,20A2,2 0 0,1 17,18M1,2H4.27L5.21,4H20A1,1 0 0,1 21,5C21,5.17 20.95,5.34 20.88,5.5L17.3,11.97C16.96,12.58 16.3,13 15.55,13H8.1L7.2,14.63L7.17,14.75A0.25,0.25 0 0,0 7.42,15H19V17H7C5.89,17 5,16.1 5,15C5,14.65 5.09,14.32 5.24,14.04L6.6,11.59L3,4H1V2M7,18A2,2 0 0,1 9,20A2,2 0 0,1 7,22A2,2 0 0,1 5,20A2,2 0 0,1 7,18Z"
                                  Fill="#60A5FA" Stretch="Uniform" Width="18" Height="18" VerticalAlignment="Center"/>
                            <TextBlock Text="Каса" Foreground="#60A5FA" FontWeight="Bold" FontSize="14" Margin="12,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <Border Background="Transparent" Padding="14,10" Margin="0,0,0,6" Cursor="Hand">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="M12.5,8C9.85,8 7.45,9 5.6,10.6L2,7V16H11L7.38,12.38C8.77,11.22 10.54,10.5 12.5,10.5C16.04,10.5 19.05,12.81 20.1,16L22.47,15.22C21.08,11.03 17.15,8 12.5,8Z"
                                  Fill="#8E9CAE" Stretch="Uniform" Width="18" Height="18" VerticalAlignment="Center"/>
                            <TextBlock Text="Повернення" Foreground="#8E9CAE" FontSize="14" Margin="12,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <Border Background="Transparent" Padding="14,10" Margin="0,0,0,6" Cursor="Hand">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="M12,20A8,8 0 0,0 20,12A8,8 0 0,0 12,4A8,8 0 0,0 4,12A8,8 0 0,0 12,20M12,2A10,10 0 0,1 22,12A10,10 0 0,1 12,22C6.47,22 2,17.5 2,12A10,10 0 0,1 12,2M12.5,7V12.25L17,14.92L16.25,16.15L11,13V7H12.5Z"
                                  Fill="#8E9CAE" Stretch="Uniform" Width="18" Height="18" VerticalAlignment="Center"/>
                            <TextBlock Text="Управління зміною" Foreground="#8E9CAE" FontSize="14" Margin="12,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <Border Grid.Row="3" Background="#1A2234" CornerRadius="12" Padding="16,14" Margin="16,0,16,24">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="7" Height="7" Fill="#10B981" VerticalAlignment="Center"/>
                            <TextBlock Text="Зміна відкрита" Foreground="#94A3B8" FontSize="12" Margin="8,0,0,0"/>
                        </StackPanel>
                        <TextBlock Text="{Binding CashierName}" Foreground="White" FontWeight="SemiBold" FontSize="15" Margin="0,8,0,2"/>
                        <TextBlock Text="{Binding ShiftInfo}" Foreground="#64748B" FontSize="12"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="68"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="White" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1">
                <DockPanel LastChildFill="False">
                    <Border DockPanel.Dock="Left" Width="520" Height="42" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Margin="24,0,0,0">
                        <Grid>
                            <Path Data="M9.5,3A6.5,6.5 0 0,1 16,9.5C16,11.11 15.41,12.59 14.44,13.73L14.71,14H15.5L20.5,19L19,20.5L14,15.5V14.71L13.73,14.44C12.59,15.41 11.11,16 9.5,16A6.5,6.5 0 0,1 3,9.5A6.5,6.5 0 0,1 9.5,3M9.5,5C7,5 5,7 5,9.5C5,12 7,14 9.5,14C12,14 14,12 14,9.5C14,7 12,5 9.5,5Z"
                                  Fill="#94A3B8" Stretch="Uniform" Width="16" Height="16" HorizontalAlignment="Left" Margin="14,0,0,0"/>
                            <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" Background="Transparent" BorderThickness="0" VerticalAlignment="Center" Padding="38,0,45,0" FontSize="13" Foreground="#1E293B"/>
                            <Border HorizontalAlignment="Right" Background="#F1F5F9" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="4" Padding="6,2" Margin="0,0,10,0">
                                <TextBlock Text="F2" FontSize="11" Foreground="#64748B"/>
                            </Border>
                        </Grid>
                    </Border>

                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="0,0,24,0" VerticalAlignment="Center">
                        <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="10" Padding="10,6" Margin="0,0,14,0">
                            <StackPanel Orientation="Horizontal">
                                <Border Width="28" Height="28" CornerRadius="6" Background="#EFF6FF" VerticalAlignment="Center">
                                    <Path Data="M12,18H6V14H12M21,14V12L20,7H4L3,12V14H4V20H14V14H18V20H20V14M20,4H4V6H20V4Z"
                                          Fill="#2563EB" Stretch="Uniform" Width="14" Height="14" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel Margin="8,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding StoreLocation}" FontWeight="SemiBold" FontSize="12" Foreground="#1E293B"/>
                                    <StackPanel Orientation="Horizontal">
                                        <Ellipse Width="6" Height="6" Fill="#10B981" VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding CashRegister}" Foreground="#64748B" FontSize="11" Margin="6,0,0,0"/>
                                    </StackPanel>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <Border Width="38" Height="38" CornerRadius="19" BorderBrush="#E2E8F0" BorderThickness="1" Background="White" Margin="0,0,10,0" Cursor="Hand">
                            <Path Data="M21,19V20H3V19L5,17V11C5,7.9 7.03,5.17 10,4.29C10,4.19 10,4.1 10,4A2,2 0 0,1 12,2A2,2 0 0,1 14,4C14,4.1 14,4.19 14,4.29C16.97,5.17 19,7.9 19,11V17L21,19M14,21A2,2 0 0,1 12,23A2,2 0 0,1 10,21"
                                  Fill="#64748B" Stretch="Uniform" Width="16" Height="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>

                        <Border Width="38" Height="38" CornerRadius="19" Background="#DBEAFE" Cursor="Hand">
                            <TextBlock Text="ОК" Foreground="#1D4ED8" FontWeight="Bold" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </StackPanel>
                </DockPanel>
            </Border>

            <Grid Grid.Row="1" Margin="24,20,24,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="380"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Background="White" CornerRadius="14" BorderBrush="#E2E8F0" BorderThickness="1" Padding="24">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0" Margin="0,0,0,16">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Поточний чек" FontSize="20" FontWeight="Bold" Foreground="#0F172A"/>
                                    <Border Background="#EEF2FF" CornerRadius="10" Padding="8,2" Margin="10,0,0,0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding TotalItemsCountText}" Foreground="#4F46E5" FontSize="12" FontWeight="SemiBold"/>
                                    </Border>
                                </StackPanel>
                                <TextBlock Text="{Binding ReceiptNumber}" Foreground="#94A3B8" FontSize="12" Margin="0,4,0,0"/>
                            </StackPanel>

                            <Border HorizontalAlignment="Right" Background="White" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="8" Padding="12,6" Cursor="Hand">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="M2,6H4V18H2V6M5,6H6V18H5V6M7,6H10V18H7V6M11,6H12V18H11V6M14,6H16V18H14V6M17,6H20V18H17V6M21,6H22V18H21V6Z"
                                          Fill="#1E293B" Stretch="Uniform" Width="14" Height="14" VerticalAlignment="Center"/>
                                    <TextBlock Text="Сканувати" Foreground="#1E293B" FontWeight="SemiBold" FontSize="13" Margin="8,0,0,0"/>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <Grid Grid.Row="1" Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2.3*"/>
                                <ColumnDefinition Width="1.5*"/>
                                <ColumnDefinition Width="1.2*"/>
                                <ColumnDefinition Width="1.2*"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0" Text="НАЗВА" Foreground="#94A3B8" FontSize="11" FontWeight="SemiBold"/>
                            <TextBlock Grid.Column="1" Text="СПЕЦИФІКАЦІЯ" Foreground="#94A3B8" FontSize="11" FontWeight="SemiBold"/>
                            <TextBlock Grid.Column="2" Text="К-СТЬ" Foreground="#94A3B8" FontSize="11" FontWeight="SemiBold"/>
                            <TextBlock Grid.Column="3" Text="ЦІНА" Foreground="#94A3B8" FontSize="11" FontWeight="SemiBold"/>
                        </Grid>

                        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding CartItems}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderBrush="#F1F5F9" BorderThickness="0,0,0,1" Padding="0,12,0,12">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="2.3*"/>
                                                    <ColumnDefinition Width="1.5*"/>
                                                    <ColumnDefinition Width="1.2*"/>
                                                    <ColumnDefinition Width="1.2*"/>
                                                </Grid.ColumnDefinitions>

                                                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                                    <Border Width="44" Height="44" Background="#F1F5F9" CornerRadius="8" Margin="0,0,12,0">
                                                        <Path Data="M16,21H8A1,1 0 0,1 7,20V12H4A1,1 0 0,1 3,11L5,4A2,2 0 0,1 7,2H17A2,2 0 0,1 19,4L21,11A1,1 0 0,1 20,12H17V20A1,1 0 0,1 16,21Z"
                                                              Fill="#94A3B8" Stretch="Uniform" Width="18" Height="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </Border>
                                                    <StackPanel VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="14" Foreground="#0F172A"/>
                                                        <TextBlock Text="{Binding Sku}" FontSize="12" Foreground="#94A3B8" Margin="0,2,0,0"/>
                                                    </StackPanel>
                                                </StackPanel>

                                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Category}" FontSize="12" Foreground="#64748B"/>
                                                    <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="4" Padding="6,2" HorizontalAlignment="Left" Margin="0,4,0,0">
                                                        <TextBlock Text="{Binding Tag}" FontSize="12" Foreground="#1E293B"/>
                                                    </Border>
                                                </StackPanel>

                                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                                    <Border Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Height="32">
                                                        <StackPanel Orientation="Horizontal">
                                                            <Button Width="28" Background="Transparent" BorderThickness="0" Cursor="Hand"
                                                                    Command="{Binding DataContext.DecreaseQuantityCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                    CommandParameter="{Binding}">
                                                                <TextBlock Text="−" FontSize="14" FontWeight="Bold" Foreground="#64748B" HorizontalAlignment="Center"/>
                                                            </Button>
                                                            <TextBlock Text="{Binding Quantity}" Width="24" TextAlignment="Center" VerticalAlignment="Center" FontWeight="SemiBold" FontSize="13" Foreground="#0F172A"/>
                                                            <Button Width="28" Background="Transparent" BorderThickness="0" Cursor="Hand"
                                                                    Command="{Binding DataContext.IncreaseQuantityCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                    CommandParameter="{Binding}">
                                                                <TextBlock Text="+" FontSize="14" FontWeight="Bold" Foreground="#64748B" HorizontalAlignment="Center"/>
                                                            </Button>
                                                        </StackPanel>
                                                    </Border>
                                                </StackPanel>

                                                <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding TotalPriceText}" FontWeight="Bold" FontSize="15" Foreground="#0F172A" VerticalAlignment="Center"/>
                                                    <Button Margin="16,0,0,0" Background="Transparent" BorderThickness="0" Cursor="Hand"
                                                            Command="{Binding DataContext.RemoveItemCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                            CommandParameter="{Binding}">
                                                        <Path Data="M19,4H15.5L14.5,3H9.5L8.5,4H5V6H19M6,19A2,2 0 0,0 8,21H16A2,2 0 0,0 18,19V7H6V19Z"
                                                              Fill="#94A3B8" Stretch="Uniform" Width="14" Height="14"/>
                                                    </Button>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>

                        <Grid Grid.Row="3" Margin="0,16,0,0">
                            <TextBlock Text="⌨ F2 — пошук · Del — видалити позицію" Foreground="#94A3B8" FontSize="12" VerticalAlignment="Center"/>
                            <Button HorizontalAlignment="Right" Background="Transparent" BorderThickness="0" Cursor="Hand" Command="{Binding ClearCartCommand}">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="M19,4H15.5L14.5,3H9.5L8.5,4H5V6H19M6,19A2,2 0 0,0 8,21H16A2,2 0 0,0 18,19V7H6V19Z"
                                          Fill="#EF4444" Stretch="Uniform" Width="13" Height="13" VerticalAlignment="Center"/>
                                    <TextBlock Text="Очистити чек" Foreground="#EF4444" FontWeight="Medium" FontSize="13" Margin="6,0,0,0"/>
                                </StackPanel>
                            </Button>
                        </Grid>
                    </Grid>
                </Border>

                <Border Grid.Column="1" Background="White" CornerRadius="14" BorderBrush="#E2E8F0" BorderThickness="1" Margin="16,0,0,0">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="24">
                        <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0">
                            <StackPanel>
                                <TextBlock Text="До сплати" FontSize="18" FontWeight="Bold" Foreground="#0F172A"/>
                                <TextBlock Text="Перевірте замовлення" Foreground="#94A3B8" FontSize="12" Margin="0,4,0,0"/>
                            </StackPanel>
                            <Border HorizontalAlignment="Right" Width="32" Height="32" CornerRadius="8" Background="#ECFDF5">
                                <Path Data="M12,1L3,5V11C3,16.55 6.84,21.74 12,23C17.16,21.74 21,16.55 21,11V5L12,1M10,17L6,13L7.41,11.59L10,14.17L16.59,7.58L18,9L10,17Z"
                                      Fill="#10B981" Stretch="Uniform" Width="16" Height="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </Grid>

                        <Border Grid.Row="1" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Height="44" Padding="12,0" Margin="0,16,0,0" Cursor="Hand">
                            <DockPanel LastChildFill="False">
                                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Path Data="M12,4A4,4 0 0,1 16,8A4,4 0 0,1 12,12A4,4 0 0,1 8,8A4,4 0 0,1 12,4M12,14C16.42,14 20,15.79 20,18V20H4V18C4,15.79 7.58,14 12,14Z"
                                          Fill="#3B82F6" Stretch="Uniform" Width="14" Height="14" VerticalAlignment="Center"/>
                                    <TextBlock Text="Додати покупця" Foreground="#334155" FontSize="13" Margin="8,0,0,0" VerticalAlignment="Center"/>
                                </StackPanel>
                                <TextBlock DockPanel.Dock="Right" Text="›" Foreground="#94A3B8" FontSize="16" FontWeight="Bold" VerticalAlignment="Center"/>
                            </DockPanel>
                        </Border>

                        <StackPanel Grid.Row="2" Margin="0,20,0,0">
                            <DockPanel Margin="0,0,0,10">
                                <TextBlock DockPanel.Dock="Left" Text="Сума товарів" Foreground="#64748B" FontSize="13"/>
                                <TextBlock DockPanel.Dock="Right" Text="{Binding SubtotalText}" Foreground="#0F172A" FontSize="14"/>
                            </DockPanel>
                            <DockPanel Margin="0,0,0,10">
                                <TextBlock DockPanel.Dock="Left" Text="Знижка" Foreground="#64748B" FontSize="13"/>
                                <TextBlock DockPanel.Dock="Right" Text="{Binding DiscountText}" Foreground="#0F172A" FontSize="14"/>
                            </DockPanel>
                            <DockPanel Margin="0,0,0,16">
                                <TextBlock DockPanel.Dock="Left" Text="До оплати" FontWeight="Bold" Foreground="#0F172A" FontSize="14"/>
                                <TextBlock DockPanel.Dock="Right" Text="{Binding TotalPayableText}" FontWeight="Bold" Foreground="#0F172A" FontSize="15"/>
                            </DockPanel>
                        </StackPanel>

                        <Button Grid.Row="3" Height="40" Background="White" BorderBrush="#3B82F6" BorderThickness="1" Style="{StaticResource RoundedButtonStyle}">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="M18.6 15.6L13.4 10.4C14 9.3 14 8 13.3 7.3C12.5 6.5 11.2 6.5 10.4 7.3C9.6 8.1 9.6 9.4 10.4 10.2C11.1 10.9 12.4 10.9 13.5 10.3L18.7 15.5C18.9 15.7 19.3 15.7 19.5 15.5C19.7 15.3 19.7 14.9 19.5 14.7L18.6 15.6M12 2A10 10 0 1 0 22 12A10 10 0 0 0 12 2Z"
                                      Fill="#2563EB" Stretch="Uniform" Width="14" Height="14" VerticalAlignment="Center"/>
                                <TextBlock Text="Застосувати знижку" Foreground="#2563EB" FontWeight="SemiBold" FontSize="13" Margin="8,0,0,0"/>
                            </StackPanel>
                        </Button>

                        <StackPanel Grid.Row="4" Margin="0,22,0,0">
                            <TextBlock Text="Спосіб оплати" Foreground="#64748B" FontSize="12" Margin="0,0,0,8"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="10"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <Button Grid.Column="0" Height="42" Command="{Binding SelectCardCommand}">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource RoundedButtonStyle}">
                                            <Setter Property="BorderThickness" Value="1"/>
                                            <Style.Triggers>
